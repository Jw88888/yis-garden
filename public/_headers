# Content-hashed assets never change under a given name — cache them hard.
/style.*.css
  Cache-Control: public, max-age=31536000, immutable
/js/affiliate.*.js
  Cache-Control: public, max-age=31536000, immutable

# Keep the *.pages.dev mirror out of search results; yisgarden.com is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
